---
// Hero section — no props needed, purely presentational
---

<header class="hero">
  <div class="container-content hero-inner">
    <div class="hero-badge">
      <span class="hero-badge-dot" aria-hidden="true"></span>
      Universal Reference
    </div>

    <h1 class="hero-title">
      Regex Cheat Sheet
    </h1>

    <p class="hero-subtitle">
      The baseline syntax shared across all major regex engines —
      JavaScript, Python, Java, Ruby, Go, and more.
      Bookmark it, search it, reference it.
    </p>

    <nav class="hero-toc" aria-label="Jump to section">
      <a href="#character-classes" class="toc-link">Character Classes</a>
      <a href="#anchors" class="toc-link">Anchors</a>
      <a href="#quantifiers" class="toc-link">Quantifiers</a>
      <a href="#groups-lookarounds" class="toc-link">Groups &amp; Lookarounds</a>
      <a href="#flags" class="toc-link">Flags</a>
    </nav>
  </div>
</header>

<style>
  .hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-section);
    padding-bottom: var(--space-xxl);
    position: relative;
    overflow: hidden;
  }

  /* Subtle dot-grid texture */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      rgb(91 33 182 / 0.06) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
    pointer-events: none;
  }

  /* Soft violet glow top-right */
  .hero::after {
    content: "";
    position: absolute;
    top: -80px;
    right: -80px;
    width: 400px;
    height: 400px;
    background: radial-gradient(
      circle at center,
      rgb(139 92 246 / 0.15) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .hero-badge-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(0.8); }
  }

  .hero-title {
    font-family: var(--font-sans);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin: 0;
  }

  .hero-subtitle {
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0;
    max-width: 55ch;
  }

  .hero-toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .toc-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    padding: 5px 12px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
    white-space: nowrap;
  }

  .toc-link:hover {
    background: var(--color-accent-subtle);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: var(--space-xxl);
    }
  }
</style>
