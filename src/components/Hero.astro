---
interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
}

const {
  badge = "Universal Reference",
  title = "Regex Cheat Sheet",
  subtitle = "The baseline syntax shared across all major regex engines — JavaScript, Python, Java, Ruby, Go, and more. Bookmark it, search it, reference it.",
} = Astro.props;
---

<header class="hero">
  <div class="container-wide hero-inner">
    <div class="hero-badge">
      <span class="hero-badge-dot" aria-hidden="true"></span>
      {badge}
    </div>

    <h1 class="hero-title">
      {title}
    </h1>

    <p class="hero-subtitle">
      {subtitle}
    </p>
  </div>
</header>

<style>
  .hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-section);
    padding-bottom: var(--space-xl);
    position: relative;
    overflow: hidden;
  }

  /* Subtle dot-grid texture */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 6%, transparent) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
    pointer-events: none;
  }

  /* Soft violet glow top-right */
  .hero::after {
    content: "";
    position: absolute;
    top: -80px;
    right: -80px;
    width: 400px;
    height: 400px;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--color-accent) 15%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .hero-badge-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  .hero-title {
    font-family: var(--font-sans);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin: 0;
  }

  .hero-subtitle {
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0;
    max-width: 55ch;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: var(--space-xxl);
    }
  }
</style>
