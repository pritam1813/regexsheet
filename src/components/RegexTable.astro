---
import type { RegexCategory } from "../data/regex";

interface Props {
  category: RegexCategory;
}

const { category } = Astro.props;
---

<section
  class="mb-12 scroll-mt-28"
  id={category.id}
  aria-labelledby={`heading-${category.id}`}
>
  <h2
    class="font-sans text-lg font-semibold tracking-tight text-ink mb-3 pb-2 border-b-2 border-accent flex items-center gap-2"
    id={`heading-${category.id}`}
  >
    {category.title}
  </h2>

  <div
    class="rounded-xl border border-border bg-surface shadow-card overflow-hidden"
  >
    <div class="overflow-x-auto">
      <table
        class="w-full min-w-100 border-collapse text-left text-sm table-fixed"
      >
        <thead>
          <tr class="bg-surface-raised border-b border-border">
            <th
              scope="col"
              class="w-[30%] px-4 py-3 sm:px-5 sm:py-3.5 text-[0.7rem] font-bold uppercase tracking-wider text-muted whitespace-nowrap"
            >
              Syntax
            </th>
            <th
              scope="col"
              class="w-[38%] px-4 py-3 sm:px-5 sm:py-3.5 text-[0.7rem] font-bold uppercase tracking-wider text-muted"
            >
              Description
            </th>
            <th
              scope="col"
              class="w-[32%] px-4 py-3 sm:px-5 sm:py-3.5 text-[0.7rem] font-bold uppercase tracking-wider text-muted"
            >
              Example
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-soft">
          {
            category.entries.map((entry) => {
              const rawExample = entry.example ?? "";
              const arrowIdx = rawExample.indexOf("→");
              const testStr =
                arrowIdx !== -1
                  ? rawExample
                      .slice(arrowIdx + 1)
                      .replace(/[''']/g, "")
                      .trim()
                  : rawExample;
              // tryPattern: null = hide button, string = override pattern, undefined = use syntax
              const showTry = entry.tryPattern !== null;
              const tryPat = entry.tryPattern ?? entry.syntax;
              const testerHref = `/tester?p=${encodeURIComponent(tryPat)}&t=${encodeURIComponent(testStr)}`;

              return (
                <tr class="group/row transition-colors duration-150 hover:bg-hover">
                  <td class="px-4 py-3 sm:px-5 sm:py-3.5 align-middle min-w-0">
                    <div class="flex items-center gap-3 min-w-0">
                      {/* Interactive Syntax Badge (Copies on Click with Tooltip & Color Transition) */}
                      <div class="relative group/syntax inline-flex min-w-0">
                        <button
                          type="button"
                          class="overflow-hidden text-ellipsis max-w-full copy-syntax-btn inline-flex items-center gap-1.5 font-mono text-xs sm:text-[0.85rem] font-semibold text-accent bg-accent-subtle hover:bg-accent hover:text-on-accent active:scale-95 px-2 py-0.5 rounded-sm tracking-wide transition-all duration-150 cursor-pointer text-left whitespace-nowrap focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
                          data-copy-syntax={entry.syntax}
                          aria-label={`Copy syntax: ${entry.syntax}`}
                          title={entry.syntax}
                        >
                          <span>{entry.syntax}</span>
                        </button>
                        <span class="tooltip-text pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-1.5 hidden group-hover/syntax:block group-focus-within/syntax:block bg-accent text-on-accent text-[0.6875rem] font-medium px-2 py-0.5 rounded shadow-md whitespace-nowrap z-30">
                          Copy syntax
                        </span>
                      </div>

                      {/* Try Now Button (Up-Right Icon) with Tooltip */}
                      {showTry && (
                      <div class="relative group/tooltip opacity-0 group-hover/row:opacity-100 group-focus-within/row:opacity-100 transition-opacity duration-150 shrink-0">
                        <a
                          href={testerHref}
                          class="inline-flex items-center justify-center size-7 text-muted bg-surface border border-border hover:bg-accent hover:border-accent hover:text-on-accent active:bg-accent-hover active:scale-95 rounded-md shadow-xs transition-all duration-150"
                          aria-label={`Try ${entry.syntax} in live tester`}
                        >
                          <svg
                            class="size-3.5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M7 17L17 7" />
                            <path d="M7 7h10v10" />
                          </svg>
                        </a>
                        <span class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-1.5 hidden group-hover/tooltip:block group-focus-within/tooltip:block bg-accent text-on-accent text-[0.6875rem] font-medium px-2 py-0.5 rounded shadow-md whitespace-nowrap z-30">
                          Try in tester
                        </span>
                      </div>
                      )}
                    </div>
                  </td>
                  <td
                    class="px-4 py-3 sm:px-5 sm:py-3.5 align-middle text-ink text-sm leading-relaxed min-w-36"
                    title={entry.description}
                  >
                    <span class="line-clamp-2">{entry.description}</span>
                  </td>
                  <td class="px-4 py-3 sm:px-5 sm:py-3.5 align-middle text-sm">
                    {entry.example ? (
                      <code
                        class="font-mono text-xs text-muted bg-surface-raised px-2 py-1 rounded-sm block max-w-full overflow-hidden text-ellipsis whitespace-nowrap"
                        title={entry.example}
                      >
                        {entry.example}
                      </code>
                    ) : (
                      <span class="text-muted opacity-40">—</span>
                    )}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  function initCopySyntax() {
    document.addEventListener("click", async (e) => {
      const target = (e.target as HTMLElement)?.closest(
        ".copy-syntax-btn",
      ) as HTMLButtonElement | null;
      if (!target) return;

      const syntax = target.getAttribute("data-copy-syntax");
      if (!syntax) return;

      try {
        await navigator.clipboard.writeText(syntax);

        const tooltip = target.parentElement?.querySelector(".tooltip-text");

        if (tooltip) {
          tooltip.textContent = "Copied!";

          setTimeout(() => {
            tooltip.textContent = "Copy syntax";
          }, 1800);
        }
      } catch (err) {
        console.error("Failed to copy syntax:", err);
      }
    });
  }

  if (!(window as any).__regexTableCopyInitialized) {
    (window as any).__regexTableCopyInitialized = true;
    initCopySyntax();
  }
</script>
