---
import type { RegexCategory } from "../data/regex";

interface Props {
  category: RegexCategory;
}

const { category } = Astro.props;
---

<section class="category-section" id={category.id} aria-labelledby={`heading-${category.id}`}>
  <h2 class="category-heading" id={`heading-${category.id}`}>
    {category.title}
  </h2>
  <div class="table-wrapper">
    <table class="regex-table" role="table">
      <thead>
        <tr>
          <th scope="col">Syntax</th>
          <th scope="col">Description</th>
          <th scope="col">Example</th>
        </tr>
      </thead>
      <tbody>
        {
          category.entries.map((entry) => {
            const rawExample = entry.example ?? "";
            const arrowIdx = rawExample.indexOf("→");
            const testStr = arrowIdx !== -1
              ? rawExample.slice(arrowIdx + 1).replace(/[''']/g, "").trim()
              : rawExample;
            const testerHref = `/tester?p=${encodeURIComponent(entry.syntax)}&t=${encodeURIComponent(testStr)}`;

            return (
              <tr>
                <td>
                  <a
                    href={testerHref}
                    class="syntax-link"
                    title={`Try ${entry.syntax} in the live tester`}
                    aria-label={`${entry.syntax} — try in live tester`}
                  >
                    <code class="syntax-code">{entry.syntax}</code>
                    <svg class="syntax-try-icon" width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                      <path d="M2.5 5.5h6M6 2.5l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </td>
                <td class="description-cell">{entry.description}</td>
                <td>
                  {entry.example ? (
                    <code class="example-code">{entry.example}</code>
                  ) : (
                    <span class="no-example">—</span>
                  )}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .category-section {
    margin-bottom: var(--space-xxl);
    scroll-margin-top: 116px;
  }

  .category-heading {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0 0 var(--space-md) 0;
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-accent);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .table-wrapper {
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .regex-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .regex-table thead tr {
    background: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-border);
  }

  .regex-table th {
    padding: var(--space-sm) var(--space-md);
    text-align: left;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    white-space: nowrap;
  }

  /* Syntax — fixed narrow */
  .regex-table th:nth-child(1) {
    width: 16%;
  }

  /* Example — fixed share */
  .regex-table th:nth-child(3) {
    width: 38%;
  }

  .regex-table tbody tr {
    border-bottom: 1px solid var(--color-border-soft);
    transition: background 0.12s ease;
  }

  .regex-table tbody tr:last-child {
    border-bottom: none;
  }

  .regex-table tbody tr:hover {
    background: var(--color-hover);
  }

  .regex-table td {
    padding: var(--space-sm) var(--space-md);
    vertical-align: middle;
    line-height: 1.5;
  }

  /* ── Syntax cell — the badge is a link ──────────────────── */
  .syntax-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    text-decoration: none;
  }

  .syntax-code {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: background 0.14s ease, color 0.14s ease;
  }

  /* Arrow icon — hidden until row is hovered */
  .syntax-try-icon {
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .regex-table tbody tr:hover .syntax-try-icon {
    opacity: 1;
    transform: translateX(0);
  }

  .syntax-link:hover .syntax-code {
    background: var(--color-accent);
    color: #fff;
  }

  .syntax-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: var(--radius-xs);
  }

  .syntax-link:focus-visible .syntax-try-icon {
    opacity: 1;
    transform: translateX(0);
  }

  .description-cell {
    color: var(--color-ink);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .example-code {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
    background: var(--color-surface-raised);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .no-example {
    color: var(--color-muted);
    opacity: 0.4;
  }

  @media (max-width: 640px) {
    .regex-table th:nth-child(3),
    .regex-table td:nth-child(3) {
      display: none;
    }

    .regex-table th:nth-child(1) {
      width: 34%;
    }
  }
</style>
