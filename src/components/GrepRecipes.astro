---
import { grepRecipes } from "../data/grepRegex";
---

<section class="recipes-section" id="recipes" aria-labelledby="recipes-heading">
  <div class="recipes-header">
    <h2 class="category-heading" id="recipes-heading">Grep Command Recipes</h2>
    <p class="recipes-subtext">Common real-world CLI examples for search, log analysis, and file filtering using <code>grep</code>.</p>
  </div>

  <div class="recipes-grid">
    {grepRecipes.map((recipe) => (
      <div class="recipe-card" id={recipe.id}>
        <div class="recipe-card-header">
          <h3 class="recipe-title">{recipe.title}</h3>
          <span class="recipe-badge">grep</span>
        </div>
        <p class="recipe-desc">{recipe.description}</p>
        
        <div class="command-block">
          <div class="code-top-bar">
            <span class="code-lang">bash</span>
            <button
              type="button"
              class="copy-btn"
              data-code={recipe.command}
              aria-label={`Copy command for ${recipe.title}`}
            >
              <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="copy-text">Copy</span>
            </button>
          </div>
          <pre class="recipe-code"><code>{recipe.command}</code></pre>
        </div>

        <p class="recipe-explanation">
          <span class="expl-icon">💡</span> {recipe.explanation}
        </p>
      </div>
    ))}
  </div>
</section>

<script>
  function setupGrepCopyButtons() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".copy-btn");
    buttons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const code = btn.getAttribute("data-code");
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code);
          const textSpan = btn.querySelector(".copy-text");
          if (textSpan) {
            const originalText = textSpan.textContent;
            textSpan.textContent = "Copied!";
            btn.classList.add("copied");
            setTimeout(() => {
              textSpan.textContent = originalText;
              btn.classList.remove("copied");
            }, 2000);
          }
        } catch (err) {
          console.error("Failed to copy text", err);
        }
      });
    });
  }

  setupGrepCopyButtons();
  document.addEventListener("astro:page-load", setupGrepCopyButtons);
</script>

<style>
  .recipes-section {
    margin-bottom: var(--space-xxl);
    scroll-margin-top: 116px;
  }

  .recipes-header {
    margin-bottom: var(--space-md);
  }

  .category-heading {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs) 0;
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-accent);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .recipes-subtext {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
  }

  .recipes-subtext code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 1px 5px;
    border-radius: var(--radius-xs);
  }

  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    margin-top: var(--space-md);
  }

  .recipe-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }

  .recipe-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .recipe-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
  }

  .recipe-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .recipe-desc {
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
  }

  .command-block {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    overflow: hidden;
  }

  .code-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px;
    background: var(--color-hover);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .code-lang {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    cursor: pointer;
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    transition: color 0.12s ease, background 0.12s ease, border-color 0.12s ease;
  }

  .copy-btn:hover {
    color: var(--color-ink);
    background: var(--color-hover);
    border-color: var(--color-accent);
  }

  .copy-btn.copied {
    color: var(--color-accent);
    font-weight: 600;
    border-color: var(--color-accent);
  }

  .recipe-code {
    flex: 1;
    margin: 0;
    padding: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-ink-soft);
    overflow-x: auto;
    white-space: pre;
    min-width: 0;
  }

  .recipe-explanation {
    font-size: 0.78125rem;
    color: var(--color-muted);
    line-height: 1.45;
    margin: 0;
    padding-top: 4px;
    border-top: 1px dashed var(--color-border-soft);
  }

  .expl-icon {
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .recipes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
