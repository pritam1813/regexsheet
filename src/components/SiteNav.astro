---
// Site-wide top navigation bar
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  activePath?: string;
}

const { activePath = Astro.url.pathname } = Astro.props;
const current = activePath.replace(/\/$/, "") || "/";
---

<nav class="site-nav" aria-label="Site navigation">
  <div class="container-wide nav-inner">
    <a href="/" class="nav-brand" aria-label="Regex Cheat Sheet home">
      <svg class="nav-logo" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="24" height="24" rx="6" fill="currentColor" opacity="0.12"/>
        <text x="4" y="17" font-family="monospace" font-weight="bold" font-size="14" fill="currentColor">.*</text>
      </svg>
      <span class="nav-brand-name">regexsheet</span>
      <span class="nav-brand-tld">.com</span>
    </a>

    <div class="nav-links">
      <a href="/" class:list={["nav-link", { "nav-link--active": current === "/" }]} id="nav-home" aria-current={current === "/" ? "page" : undefined}>Home</a>
      <a href="/javascript" class:list={["nav-link", { "nav-link--active": current === "/javascript" }]} id="nav-javascript" aria-current={current === "/javascript" ? "page" : undefined}>JavaScript</a>
      <a href="/python" class:list={["nav-link", { "nav-link--active": current === "/python" }]} id="nav-python" aria-current={current === "/python" ? "page" : undefined}>Python</a>
      <a href="/csharp" class:list={["nav-link", { "nav-link--active": current === "/csharp" }]} id="nav-csharp" aria-current={current === "/csharp" ? "page" : undefined}>C#</a>
      <a href="/java" class:list={["nav-link", { "nav-link--active": current === "/java" }]} id="nav-java" aria-current={current === "/java" ? "page" : undefined}>Java</a>
      <a href="/r" class:list={["nav-link", { "nav-link--active": current === "/r" }]} id="nav-r" aria-current={current === "/r" ? "page" : undefined}>R</a>
      <a href="/sql" class:list={["nav-link", { "nav-link--active": current === "/sql" }]} id="nav-sql" aria-current={current === "/sql" ? "page" : undefined}>SQL</a>
      <a href="/examples" class:list={["nav-link", { "nav-link--active": current === "/examples" }]} id="nav-examples" aria-current={current === "/examples" ? "page" : undefined}>Examples</a>
      <a href="/tester" class:list={["nav-link", "nav-link--tester", { "nav-link--active": current === "/tester" }]} id="nav-tester" aria-current={current === "/tester" ? "page" : undefined}>
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true" style="flex-shrink:0">
          <path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Tester
      </a>
      <a href="/pdf" class:list={["nav-link", "nav-link--cta", { "nav-link--active": current === "/pdf" }]} id="nav-pdf" aria-current={current === "/pdf" ? "page" : undefined}>PDF ↓</a>
      <ThemeToggle />
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    height: 56px;
    display: flex;
    align-items: center;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--color-ink);
    flex-shrink: 0;
  }

  .nav-logo {
    color: var(--color-accent);
  }

  .nav-brand-name {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .nav-brand-tld {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    transition: color 0.12s ease, background 0.12s ease;
  }

  .nav-link:hover {
    color: var(--color-ink);
    background: var(--color-hover);
  }

  .nav-link--active {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    font-weight: 600;
  }

  .nav-link--cta {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    font-weight: 600;
  }

  .nav-link--cta:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .nav-link--tester {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--color-accent);
  }

  .nav-link--tester:hover {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .nav-links {
      display: none;
    }
  }
</style>
