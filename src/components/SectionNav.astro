---
import { universalRegex } from "../data/regex";

interface NavItem {
  id: string;
  label: string;
}

interface Props {
  items?: NavItem[];
}

const defaultItems: NavItem[] = [
  ...universalRegex.map((cat) => ({
    id: cat.id,
    label: cat.title === "Flags / Modifiers" ? "Flags" : cat.title,
  })),
  { id: "explore-heading", label: "Language Guides" },
];

const { items = defaultItems } = Astro.props;
---

<nav class="sticky-nav" aria-label="Section navigation">
  <div class="container-content sticky-nav-inner">
    <div class="sticky-nav-scroll">
      {items.map((item) => (
        <a href={`#${item.id}`} class="nav-pill" data-section={item.id}>
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  function setupActiveNav() {
    const pills = document.querySelectorAll<HTMLAnchorElement>(".nav-pill");
    const sections = Array.from(pills)
      .map((pill) => {
        const id = pill.dataset.section;
        return id ? document.getElementById(id) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (!sections.length || !pills.length) return;

    let activeId = "";

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            activeId = entry.target.id;
            updateActivePill(activeId);
          }
        });
      },
      {
        rootMargin: "-110px 0px -70% 0px",
        threshold: 0,
      }
    );

    sections.forEach((sec) => observer.observe(sec));

    function updateActivePill(id: string) {
      pills.forEach((pill) => {
        const isMatch = pill.dataset.section === id;
        pill.classList.toggle("active", isMatch);
        if (isMatch) {
          pill.setAttribute("aria-current", "true");
        } else {
          pill.removeAttribute("aria-current");
        }
      });
    }
  }

  setupActiveNav();
  document.addEventListener("astro:page-load", setupActiveNav);
</script>

<style>
  .sticky-nav {
    position: sticky;
    top: 56px;
    z-index: 90;
    background: rgb(255 255 255 / 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: 8px 0;
    transition: box-shadow 0.2s ease;
  }

  .sticky-nav-inner {
    display: flex;
    align-items: center;
  }

  .sticky-nav-scroll {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 2px 0;
    width: 100%;
  }

  .sticky-nav-scroll::-webkit-scrollbar {
    display: none;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 5px 12px;
    border-radius: var(--radius-full);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease, box-shadow 0.12s ease;
    flex-shrink: 0;
  }

  .nav-pill:hover {
    background: var(--color-hover);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .nav-pill.active {
    background: var(--color-accent-subtle);
    border-color: var(--color-accent);
    color: var(--color-accent);
    font-weight: 600;
  }

  .nav-pill:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
