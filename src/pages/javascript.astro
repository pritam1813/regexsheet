---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import SectionNav from "../components/SectionNav.astro";
import RegexTable from "../components/RegexTable.astro";
import JavascriptRecipes from "../components/JavascriptRecipes.astro";
import NavCard from "../components/NavCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { javascriptRegexCategories, javascriptNavCards } from "../data/javascriptRegex";

const navItems = [
  { id: "regex-methods", label: "RegExp Methods" },
  { id: "flags", label: "Flags" },
  { id: "js-syntax", label: "JavaScript Syntax" },
  { id: "recipes", label: "Code Recipes" },
  { id: "explore-heading", label: "Other Guides" },
];
---

<Layout
  title="JavaScript Regex Cheat Sheet — RegExp & String Methods"
  description="A complete, fast JavaScript regex cheat sheet. Covers RegExp objects, String methods (match, replace, search), flags (g, i, m, s, u, v, y), named capture groups, and code recipes."
>
  <SiteNav />
  <Hero
    badge="JavaScript Reference"
    title="JavaScript Regex Cheat Sheet"
    subtitle="Complete quick reference for JavaScript's RegExp — object methods, string functions, flags, named groups, and practical code snippets."
  />
  <SectionNav items={navItems} />

  <main id="main-content" class="container-wide main">
    <!-- JavaScript Tip Callout -->
    <div class="tip-callout" role="note" aria-label="JavaScript Regex Pro Tip">
      <div class="tip-icon" aria-hidden="true">💡</div>
      <div class="tip-content">
        <span class="tip-title"
          >Pro Tip: Use regex literals <code>/.../</code> when possible</span
        >
        <p class="tip-text">
          In JavaScript, prefer literal syntax like <code>/\bword\b/gi</code> over the <code>new RegExp()</code> constructor.
          Literals are evaluated at parse time and don't require escaping backslashes twice. Only use <code>new RegExp()</code> when you need to dynamically build a pattern from a variable.
        </p>
      </div>
    </div>

    <!-- JavaScript regex reference tables -->
    <section class="tables-section" aria-label="JavaScript RegExp reference">
      {
        javascriptRegexCategories.map((category) => (
          <RegexTable category={category} />
        ))
      }
    </section>

    <!-- JavaScript Code Recipes -->
    <JavascriptRecipes />

    <!-- Nav cards to other guides -->
    <section
      class="cards-section"
      id="explore-heading"
      aria-labelledby="explore-heading-title"
    >
      <div class="cards-header">
        <h2 class="cards-heading" id="explore-heading-title">
          Explore Other Guides
        </h2>
        <p class="cards-subtext">
          Switch to universal patterns, other programming languages, or download
          offline cheatsheets.
        </p>
      </div>
      <div class="cards-grid">
        {javascriptNavCards.map((card) => <NavCard card={card} />)}
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .main {
    padding-top: var(--space-section);
    padding-bottom: var(--space-xl);
  }

  .tip-callout {
    display: flex;
    gap: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-xl);
    box-shadow: var(--shadow-card);
  }

  .tip-icon {
    font-size: 1.25rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .tip-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }

  .tip-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .tip-title code,
  .tip-text code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 1px 5px;
    border-radius: var(--radius-xs);
  }

  .tip-text {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .tables-section {
    display: flex;
    flex-direction: column;
  }

  .cards-section {
    margin-top: var(--space-section);
    padding-top: var(--space-xxl);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 116px;
  }

  .cards-header {
    margin-bottom: var(--space-xl);
  }

  .cards-heading {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs) 0;
  }

  .cards-subtext {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
