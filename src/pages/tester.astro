---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LiveRegexTester from "../components/LiveRegexTester.astro";
---

<Layout
  title="Live Regex Tester — regexsheet"
  description="Test regular expressions in real-time. Paste a pattern and a test string to see all matches highlighted instantly — no dependencies, no page reloads."
>
  <SiteNav />

  <Hero
    badge="Interactive Tool"
    title="Live Regex Tester"
    subtitle="Enter a pattern and test string — matches highlight in real-time as you type. Click Try → on any cheat-sheet row to pre-fill."
    backLinkHref="/"
    backLinkLabel="Cheat Sheet"
  />

  <main class="container-wide tester-main" id="main-content">
    <LiveRegexTester />

    <!-- Quick-reference strips -->
    <section class="quick-ref" aria-labelledby="quick-ref-heading">
      <h2 class="quick-ref-heading" id="quick-ref-heading">Quick reference</h2>
      <div class="qr-grid">
        {
          [
            {
              label: "Any digit",
              pattern: "\\d+",
              test: "Order 42 costs $9.99",
            },
            {
              label: "Email address",
              pattern: "[\\w.+-]+@[\\w-]+\\.[\\w.]+",
              test: "Contact us at hello@example.com or support@site.io",
            },
            {
              label: "Word boundary",
              pattern: "\\bcat\\b",
              test: "The cat concatenate catch a catfish",
            },
            {
              label: "Capturing group",
              pattern: "(\\d{4})-(\\d{2})-(\\d{2})",
              test: "Date: 2024-03-15",
            },
            {
              label: "Non-greedy",
              pattern: "<.+?>",
              test: "<b>bold</b> and <i>italic</i>",
            },
            {
              label: "Lookahead",
              pattern: "\\d+(?= dollars)",
              test: "I have 42 dollars and 7 euros",
            },
          ].map((ex) => (
            <a
              class="qr-chip"
              href={`/tester?p=${encodeURIComponent(ex.pattern)}&t=${encodeURIComponent(ex.test)}`}
              aria-label={`Try example: ${ex.label}`}
            >
              <span class="qr-label">{ex.label}</span>
              <code class="qr-pattern">{ex.pattern}</code>
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* ── Main ───────────────────────────────────────────────── */
  .tester-main {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-section);
    display: flex;
    flex-direction: column;
    gap: var(--space-xxl);
  }

  /* ── Quick reference ────────────────────────────────────── */
  .quick-ref {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .quick-ref-heading {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin: 0;
  }

  .qr-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .qr-chip {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition:
      border-color 0.12s ease,
      box-shadow 0.12s ease,
      background 0.12s ease;
    cursor: pointer;
  }

  .qr-chip:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
    box-shadow: var(--shadow-card-hover);
  }

  .qr-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .qr-chip:hover .qr-label {
    color: var(--color-accent);
  }

  .qr-pattern {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 640px) {
    .qr-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 400px) {
    .qr-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
