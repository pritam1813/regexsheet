---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import SectionNav from "../components/SectionNav.astro";
import RegexTable from "../components/RegexTable.astro";
import RRecipes from "../components/RRecipes.astro";
import NavCard from "../components/NavCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { rRegexCategories, rNavCards } from "../data/rRegex";

const navItems = [
  { id: "base-functions", label: "Base R Functions" },
  { id: "stringr-functions", label: "stringr / Tidyverse" },
  { id: "flags-options", label: "Flags & Modifiers" },
  { id: "r-syntax", label: "Syntax & POSIX" },
  { id: "recipes", label: "Code Recipes" },
  { id: "explore-heading", label: "Other Guides" },
];
---

<Layout
  title="R Regex Cheat Sheet — Base R & stringr Reference"
  description="A complete, fast R regex cheat sheet. Covers Base R functions (grep, grepl, sub, gsub, regmatches), Tidyverse stringr functions (str_detect, str_extract, str_match), PCRE flags (perl = TRUE), POSIX character classes, and R 4.0+ raw string literals."
>
  <SiteNav />
  <Hero
    badge="R Reference"
    title="R Regex Cheat Sheet"
    subtitle="Complete quick reference for Base R and stringr (Tidyverse) — functions, extraction, POSIX classes, raw string syntax, and practical recipes."
  />
  <SectionNav items={navItems} />

  <main id="main-content" class="container-wide main">
    <!-- R Tip Callout -->
    <div class="tip-callout" role="note" aria-label="R Regex Pro Tip">
      <div class="tip-icon" aria-hidden="true">💡</div>
      <div class="tip-content">
        <span class="tip-title"
          >Pro Tip: Use R 4.0+ Raw String Literals <code>r"(...)"</code> or double escape <code>"\\d"</code></span
        >
        <p class="tip-text">
          In standard R strings <code>"..."</code>, backslashes must be escaped twice (e.g. <code>"\\d+"</code> or <code>"\\bword\\b"</code>).
          In R 4.0+, you can use raw strings like <code>r"(\d+\s+\w+)"</code> or <code>r"-(\b[A-Z]+\b)-"</code> to write cleaner regex patterns without double backslashes.
          For lookarounds and named capture groups in Base R, remember to pass <code>perl = TRUE</code>.
        </p>
      </div>
    </div>

    <!-- R regex reference tables -->
    <section class="tables-section" aria-label="R regex reference">
      {
        rRegexCategories.map((category) => (
          <RegexTable category={category} />
        ))
      }
    </section>

    <!-- R Code Recipes -->
    <RRecipes />

    <!-- Nav cards to other guides -->
    <section
      class="cards-section"
      id="explore-heading"
      aria-labelledby="explore-heading-title"
    >
      <div class="cards-header">
        <h2 class="cards-heading" id="explore-heading-title">
          Explore Other Guides
        </h2>
        <p class="cards-subtext">
          Switch to universal patterns, other programming languages, or test expressions in the live tester.
        </p>
      </div>
      <div class="cards-grid">
        {rNavCards.map((card) => <NavCard card={card} />)}
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .main {
    padding-top: var(--space-section);
    padding-bottom: var(--space-xl);
  }

  .tip-callout {
    display: flex;
    gap: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-xl);
    box-shadow: var(--shadow-card);
  }

  .tip-icon {
    font-size: 1.25rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .tip-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }

  .tip-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .tip-title code,
  .tip-text code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 1px 5px;
    border-radius: var(--radius-xs);
  }

  .tip-text {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .tables-section {
    display: flex;
    flex-direction: column;
  }

  .cards-section {
    margin-top: var(--space-section);
    padding-top: var(--space-xxl);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 116px;
  }

  .cards-header {
    margin-bottom: var(--space-xl);
  }

  .cards-heading {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs) 0;
  }

  .cards-subtext {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
