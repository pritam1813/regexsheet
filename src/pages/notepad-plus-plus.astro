---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import SectionNav from "../components/SectionNav.astro";
import RegexTable from "../components/RegexTable.astro";
import NotepadppRecipes from "../components/NotepadppRecipes.astro";
import NavCard from "../components/NavCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { notepadppRegexCategories, notepadppNavCards } from "../data/notepadppRegex";

const navItems = [
  { id: "line-breaks-spaces", label: "Line Breaks & Spaces" },
  { id: "anchors-search-modes", label: "Anchors & Flags" },
  { id: "replace-tokens", label: "Replace Tokens" },
  { id: "groups-lookarounds", label: "Groups & Lookarounds" },
  { id: "recipes", label: "Find & Replace Recipes" },
  { id: "explore-heading", label: "Other Guides" },
];
---

<Layout
  title="Notepad++ Regex Cheat Sheet — Find & Replace Quick Reference"
  description="A comprehensive, fast Notepad++ regular expression cheat sheet. Covers PCRE search mode, \R universal newlines, \K keep-out, case modification (\U, \L, \u, \l), capture groups ($1, $2), and practical find & replace recipes."
>
  <SiteNav />
  <Hero
    badge="Text Editor Reference"
    title="Notepad++ Regex Cheat Sheet"
    subtitle="Complete quick reference for Find & Replace (Ctrl+H) in Notepad++ — universal line breaks (\R), case modifiers (\U, \L), capture groups, lookarounds, and batch text editing recipes."
  />
  <SectionNav items={navItems} />

  <main id="main-content" class="container-wide main">
    <!-- Notepad++ Tip Callout -->
    <div class="tip-callout" role="note" aria-label="Notepad++ Regex Pro Tip">
      <div class="tip-icon" aria-hidden="true">💡</div>
      <div class="tip-content">
        <span class="tip-title"
          >Pro Tip: Check "Regular expression" &amp; Use <code>\R</code> for Windows/Unix Newlines</span
        >
        <p class="tip-text">
          In the Find &amp; Replace window (<kbd>Ctrl+H</kbd>), set Search Mode to <strong>Regular expression</strong>.
          Use <code>\R</code> to match any line break (both Windows <code>\r\n</code> and Unix <code>\n</code>).
          Leave <strong>. matches newline</strong> unchecked unless you explicitly want dot (<code>.</code>) to span multiple lines (or use inline <code>(?s)</code> / <code>(?-s)</code>).
          In the Replace field, use <code>\U$1\E</code> or <code>\L$1\E</code> to change letter casing dynamically.
        </p>
      </div>
    </div>

    <!-- Notepad++ regex reference tables -->
    <section class="tables-section" aria-label="Notepad++ regular expressions reference">
      {
        notepadppRegexCategories.map((category) => (
          <RegexTable category={category} />
        ))
      }
    </section>

    <!-- Notepad++ Code / Find & Replace Recipes -->
    <NotepadppRecipes />

    <!-- Nav cards to other guides -->
    <section
      class="cards-section"
      id="explore-heading"
      aria-labelledby="explore-heading-title"
    >
      <div class="cards-header">
        <h2 class="cards-heading" id="explore-heading-title">
          Explore Other Guides
        </h2>
        <p class="cards-subtext">
          Switch to programming language guides, database queries, or test
          expressions interactively.
        </p>
      </div>
      <div class="cards-grid">
        {notepadppNavCards.map((card) => <NavCard card={card} />)}
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .main {
    padding-top: var(--space-section);
    padding-bottom: var(--space-xl);
  }

  .tip-callout {
    display: flex;
    gap: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-xl);
    box-shadow: var(--shadow-card);
  }

  .tip-icon {
    font-size: 1.25rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .tip-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }

  .tip-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .tip-title code,
  .tip-text code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 1px 5px;
    border-radius: var(--radius-xs);
  }

  .tip-text kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    padding: 2px 5px;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
  }

  .tip-text {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .tables-section {
    display: flex;
    flex-direction: column;
  }

  .cards-section {
    margin-top: var(--space-section);
    padding-top: var(--space-xxl);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 116px;
  }

  .cards-header {
    margin-bottom: var(--space-xl);
  }

  .cards-heading {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs) 0;
  }

  .cards-subtext {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
