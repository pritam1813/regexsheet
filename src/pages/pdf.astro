---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import NavCard from "../components/NavCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { pdfCheatSheets, pdfPath } from "../data/pdfs";

// Filter out PDF from navCards if shown in explore section
const otherNavCards = [
  {
    href: "/tester",
    title: "Live Regex Tester",
    description:
      "Interactive real-time regex playground with instant highlighting and match inspector.",
    icon: "🔬",
  },
  {
    href: "/examples",
    title: "Real-World Examples",
    description:
      "Battle-tested regex patterns for emails, passwords, dates, URLs, and phone numbers.",
    icon: "⚡",
  },
  {
    href: "/python",
    title: "Python Regex Guide",
    description:
      "Complete reference for Python's re module, flags, methods, and practical recipes.",
    icon: "🐍",
  },
  {
    href: "/javascript",
    title: "JavaScript Regex Guide",
    description:
      "Modern RegExp methods, String matchAll, replace, flags, and Unicode properties.",
    icon: "💛",
  },
];
const totalPages = Math.ceil(pdfCheatSheets.length / 6);
---

<Layout
  title="Regex Cheat Sheet PDF — Download for Python, JS, SQL, Grep & More"
  description="Download free, printable PDF cheat sheets for Regular Expressions. Clean single-page references for Universal Regex, Grep (CLI), Vim, Notepad++, Perl, SQL, C# (.NET), JavaScript, Python, Java, and R engines."
>
  <SiteNav />
  <Hero
    badge="Printable References"
    title="Regex Cheat Sheet PDF Downloads"
    subtitle="Download high-resolution, single-page regex cheat sheets designed for fast offline lookups, desk pinning, and quick reference. Optimized for A4 and US Letter printing."
  />

  <main id="main-content" class="container-wide pt-16 pb-8">
    <!-- Format notice callout -->
    <div
      class="flex gap-3 sm:gap-4 bg-surface border border-border border-l-4 border-l-accent rounded-md p-4 sm:px-6 sm:py-4 mb-8 shadow-card"
      role="note"
      aria-label="PDF Cheat Sheet Information"
    >
      <div class="text-xl leading-snug shrink-0" aria-hidden="true">💡</div>
      <div class="flex flex-col gap-0.5">
        <span class="font-sans text-[15px] font-semibold text-ink">
          Designed for Print & Quick Lookups
        </span>
        <p class="text-sm text-muted leading-relaxed m-0">
          Each sheet is crafted with high-contrast typography (Inter & JetBrains
          Mono), compact tables, and zero clutter. Print them out on standard A4
          or US Letter, or save them locally for offline reference.
        </p>
      </div>
    </div>

    <!-- PDF Cards Grid -->
    <section
      class="flex flex-col mb-16"
      id="available-sheets"
      aria-label="Downloadable PDF cheat sheets"
    >
      <div class="mb-8">
        <div
          class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 sm:gap-4"
        >
          <div>
            <h2
              class="font-sans text-2xl font-bold tracking-tight text-ink m-0 mb-1"
            >
              Available Cheat Sheets
            </h2>
            <p class="text-[15px] text-muted m-0">
              Choose your language engine or grab the universal reference card.
            </p>
          </div>
          <div
            class="font-sans text-[13px] font-medium text-muted bg-surface-raised border border-border px-3.5 py-1 rounded-full whitespace-nowrap self-start sm:self-auto"
            id="pagination-status"
            aria-live="polite"
          >
            Showing <span id="visible-range" class="font-bold text-ink"
              >1 – 6</span
            > of{" "}
            <span class="font-bold text-ink">{pdfCheatSheets.length}</span> guides
          </div>
        </div>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"
        id="pdf-grid"
      >
        {
          pdfCheatSheets.map((sheet, index) => (
            <article
              class="pdf-card flex flex-col bg-surface border border-border rounded-md p-4 shadow-card hover:border-accent hover:shadow-card-hover hover:-translate-y-0.5 hover:bg-surface-raised transition-all duration-150"
              id={`pdf-card-${sheet.slug}`}
              data-index={index}
              style={index >= 6 ? "display: none;" : ""}
            >
              <div class="flex items-start justify-between gap-2 mb-2">
                <div class="flex items-start gap-2.5 min-w-0">
                  <div class="size-9 bg-accent-subtle rounded-sm flex items-center justify-center shrink-0">
                    <span class="text-xl leading-none" aria-hidden="true">
                      {sheet.icon}
                    </span>
                  </div>
                  <div class="flex flex-col gap-0.5 min-w-0">
                    <h3 class="font-sans text-base font-bold text-ink tracking-tight m-0 leading-snug">
                      {sheet.title}
                    </h3>
                  </div>
                </div>

                <a
                  href={sheet.targetPage}
                  class="inline-flex items-center justify-center size-7 rounded-sm text-muted hover:text-accent hover:bg-accent-subtle hover:translate-x-px hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 shrink-0 no-underline transition-all duration-120"
                  aria-label={`Open ${sheet.lang} online guide`}
                  title={`Open ${sheet.lang} online guide`}
                >
                  <svg
                    class="size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17L17 7" />
                    <path d="M7 7h10v10" />
                  </svg>
                </a>
              </div>

              <p class="text-[13px] text-muted leading-relaxed m-0 mb-16">
                {sheet.description}
              </p>

              <div class="flex items-center gap-1.5 mb-3 pt-1.5 border-t border-dashed border-border flex-wrap">
                <span class="text-[11px] font-bold uppercase tracking-wider text-muted-soft shrink-0">
                  Covers:
                </span>
                <div class="flex flex-wrap gap-1">
                  {sheet.highlights.map((highlight) => (
                    <span class="font-mono text-[11px] text-ink-soft bg-canvas border border-border px-1.5 py-px rounded-xs whitespace-nowrap">
                      {highlight}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex items-center justify-between gap-2 pt-2.5 border-t border-border mt-auto">
                <a
                  href={`/print/${sheet.slug}`}
                  class="inline-flex items-center gap-1.5 bg-accent-subtle text-accent font-sans text-xs font-semibold h-8 px-2.5 rounded-sm no-underline hover:bg-hover hover:text-accent-hover hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 transition-all duration-120"
                  id={`print-preview-${sheet.slug}`}
                  aria-label={`Open print preview for ${sheet.title}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    class="size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 6 2 18 2 18 9" />
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                    <rect x="6" y="14" width="12" height="8" />
                  </svg>
                  <span>Print / View</span>
                </a>

                <a
                  href={pdfPath(sheet.slug)}
                  download={`regex-${sheet.slug}-cheatsheet.pdf`}
                  class="inline-flex items-center justify-center size-8 bg-accent text-on-accent rounded-sm no-underline shadow-card hover:bg-accent-hover hover:-translate-y-px hover:shadow-card-hover focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 shrink-0 transition-all duration-120"
                  id={`download-${sheet.slug}`}
                  aria-label={`Download ${sheet.title} PDF`}
                  title={`Download ${sheet.title} PDF`}
                >
                  <svg
                    class="size-4 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                  </svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Pagination Navigation -->
      <nav
        class="flex items-center justify-center gap-2 mt-8 pt-6 border-t border-border flex-wrap"
        id="pagination-nav"
        aria-label="Cheat sheets pagination"
      >
        <button
          type="button"
          class="pagination-nav-btn inline-flex items-center gap-1.5 h-9.5 px-3.5 bg-surface text-ink border border-border rounded-sm font-sans text-[13px] font-semibold cursor-pointer shadow-card hover:not-disabled:bg-hover hover:not-disabled:text-accent-hover hover:not-disabled:border-accent hover:not-disabled:-translate-y-px hover:not-disabled:shadow-card-hover focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 disabled:opacity-45 disabled:cursor-not-allowed disabled:shadow-none disabled:text-muted transition-all duration-120"
          id="pagination-prev"
          aria-label="Go to previous page"
          disabled
        >
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Previous</span>
        </button>

        <div
          class="flex items-center gap-1.5"
          id="pagination-pages"
          role="group"
          aria-label="Pagination pages"
        >
          {
            Array.from({ length: totalPages }, (_, i) => (
              <button
                type="button"
                class={`pagination-page-btn inline-flex items-center justify-center min-w-10 h-10 px-3.5 bg-surface text-ink border border-border rounded-sm font-sans text-sm font-semibold cursor-pointer shadow-card hover:not-[.active]:bg-hover hover:not-[.active]:text-accent hover:not-[.active]:border-accent hover:not-[.active]:-translate-y-px hover:not-[.active]:shadow-card-hover focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 transition-all duration-120 [&.active]:bg-accent [&.active]:text-on-accent [&.active]:border-accent [&.active]:shadow-card-hover ${i === 0 ? "active" : ""}`}
                aria-label={`Go to page ${i + 1}`}
                aria-current={i === 0 ? "page" : undefined}
                data-page={i + 1}
              >
                {i + 1}
              </button>
            ))
          }
        </div>

        <button
          type="button"
          class="pagination-nav-btn inline-flex items-center gap-1.5 h-9.5 px-3.5 bg-surface text-ink border border-border rounded-sm font-sans text-[13px] font-semibold cursor-pointer shadow-card hover:not-disabled:bg-hover hover:not-disabled:text-accent-hover hover:not-disabled:border-accent hover:not-disabled:-translate-y-px hover:not-disabled:shadow-card-hover focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 disabled:opacity-45 disabled:cursor-not-allowed disabled:shadow-none disabled:text-muted transition-all duration-120"
          id="pagination-next"
          aria-label="Go to next page"
        >
          <span>Next</span>
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </nav>
    </section>

    <!-- Explore Other Tools & Guides -->
    <section
      class="mt-8 pt-12 border-t border-border"
      id="explore-heading"
      aria-labelledby="explore-heading-title"
    >
      <div class="mb-8">
        <h2
          class="font-sans text-[22px] font-bold tracking-tight text-ink m-0 mb-1"
          id="explore-heading-title"
        >
          Explore Interactive Guides & Tools
        </h2>
        <p class="text-[15px] text-muted m-0">
          Test expressions in real-time or explore comprehensive online
          tutorials.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {otherNavCards.map((card) => <NavCard card={card} />)}
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script is:inline>
  function initPdfPagination() {
    const grid = document.getElementById("pdf-grid");
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll(".pdf-card"));
    const totalCards = cards.length;
    const pageSize = 6;
    const totalPages = Math.ceil(totalCards / pageSize);
    if (totalPages <= 1) return;

    const prevBtn = document.getElementById("pagination-prev");
    const nextBtn = document.getElementById("pagination-next");
    const pagesContainer = document.getElementById("pagination-pages");
    const visibleRange = document.getElementById("visible-range");

    let currentPage = 1;
    const urlParams = new URLSearchParams(window.location.search);
    const initialPage = parseInt(urlParams.get("page") || "1", 10);
    if (!isNaN(initialPage) && initialPage >= 1 && initialPage <= totalPages) {
      currentPage = initialPage;
    }

    function updateButtonsState() {
      if (!pagesContainer) return;
      const pageBtns = pagesContainer.querySelectorAll(".pagination-page-btn");
      pageBtns.forEach((btn) => {
        const pageNum = parseInt(
          btn.getAttribute("data-page") || btn.textContent || "1",
          10,
        );
        const isActive = pageNum === currentPage;
        btn.classList.toggle("active", isActive);
        if (isActive) {
          btn.setAttribute("aria-current", "page");
        } else {
          btn.removeAttribute("aria-current");
        }
      });
    }

    function setPage(page, shouldScroll = false) {
      currentPage = page;
      const startIdx = (currentPage - 1) * pageSize;
      const endIdx = Math.min(startIdx + pageSize, totalCards);

      cards.forEach((card, idx) => {
        if (idx >= startIdx && idx < endIdx) {
          card.style.display = "flex";
        } else {
          card.style.display = "none";
        }
      });

      if (visibleRange) {
        visibleRange.textContent = `${startIdx + 1} – ${endIdx}`;
      }

      if (prevBtn) {
        prevBtn.disabled = currentPage === 1;
      }
      if (nextBtn) {
        nextBtn.disabled = currentPage === totalPages;
      }

      updateButtonsState();

      const url = new URL(window.location.href);
      if (currentPage === 1) {
        url.searchParams.delete("page");
      } else {
        url.searchParams.set("page", currentPage.toString());
      }
      window.history.replaceState({}, "", url.toString());

      if (shouldScroll) {
        const section = document.getElementById("available-sheets");
        if (section) {
          section.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }
    }

    if (pagesContainer) {
      const pageBtns = pagesContainer.querySelectorAll(".pagination-page-btn");
      pageBtns.forEach((btn) => {
        btn.onclick = () => {
          const pageNum = parseInt(
            btn.getAttribute("data-page") || btn.textContent || "1",
            10,
          );
          setPage(pageNum, true);
        };
      });
    }

    if (prevBtn) {
      prevBtn.onclick = () => {
        if (currentPage > 1) {
          setPage(currentPage - 1, true);
        }
      };
    }

    if (nextBtn) {
      nextBtn.onclick = () => {
        if (currentPage < totalPages) {
          setPage(currentPage + 1, true);
        }
      };
    }

    setPage(currentPage, false);
  }

  initPdfPagination();
  document.addEventListener("astro:page-load", initPdfPagination);
</script>
