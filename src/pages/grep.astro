---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import SectionNav from "../components/SectionNav.astro";
import RegexTable from "../components/RegexTable.astro";
import GrepRecipes from "../components/GrepRecipes.astro";
import NavCard from "../components/NavCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { grepRegexCategories, grepNavCards } from "../data/grepRegex";

const navItems = [
  { id: "engines-modes", label: "Engines & Modes" },
  { id: "output-matching-flags", label: "Output & Matching Flags" },
  { id: "files-dirs-context", label: "Files & Context" },
  { id: "posix-classes", label: "POSIX Character Classes" },
  { id: "recipes", label: "Command Recipes" },
  { id: "explore-heading", label: "Other Guides" },
];
---

<Layout
  title="Grep Regex Cheat Sheet — CLI Options, Flags, & Pattern Reference"
  description="A comprehensive, fast grep command & regular expressions cheat sheet. Covers grep -E (ERE), grep -P (PCRE), grep -F, output flags (-o, -v, -n, -c), recursive search (--include, --exclude-dir), context flags (-A, -B, -C), POSIX classes, and shell recipes."
>
  <SiteNav />
  <Hero
    badge="CLI & Terminal Reference"
    title="Grep Regex Cheat Sheet"
    subtitle="Complete quick reference for grep command-line options and regular expressions — Extended regex (-E), PCRE (-P), recursive search, output filtering, context lines, POSIX classes, and practical bash recipes."
  />
  <SectionNav items={navItems} />

  <main id="main-content" class="container-wide main">
    <!-- Grep Tip Callout -->
    <div class="tip-callout" role="note" aria-label="Grep Regex Pro Tip">
      <div class="tip-icon" aria-hidden="true">💡</div>
      <div class="tip-content">
        <span class="tip-title"
          >Pro Tip: Use <code>-E</code> (Extended) or <code>-P</code> (Perl) for Modern Regex Features</span
        >
        <p class="tip-text">
          Standard <code>grep</code> runs in Basic Regular Expression (BRE) mode where <code>+</code>, <code>?</code>, <code>( )</code>, and <code>|</code> require backslashes.
          Always pass <code>-E</code> (or use <code>egrep</code>) for clean modern syntax, or <code>-P</code> to unlock Perl regex tokens like <code>\d</code>, <code>\s</code>, <code>\w</code>, and lookarounds.
          Combine <code>-o</code> with <code>-P</code> to extract only exact matching substrings (e.g. IPs, URLs, hashes).
        </p>
      </div>
    </div>

    <!-- Grep regex reference tables -->
    <section class="tables-section" aria-label="Grep regular expressions reference">
      {
        grepRegexCategories.map((category) => (
          <RegexTable category={category} />
        ))
      }
    </section>

    <!-- Grep Code Recipes -->
    <GrepRecipes />

    <!-- Nav cards to other guides -->
    <section
      class="cards-section"
      id="explore-heading"
      aria-labelledby="explore-heading-title"
    >
      <div class="cards-header">
        <h2 class="cards-heading" id="explore-heading-title">
          Explore Other Guides
        </h2>
        <p class="cards-subtext">
          Switch to text editors, programming languages, database queries, or
          test expressions interactively.
        </p>
      </div>
      <div class="cards-grid">
        {grepNavCards.map((card) => <NavCard card={card} />)}
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .main {
    padding-top: var(--space-section);
    padding-bottom: var(--space-xl);
  }

  .tip-callout {
    display: flex;
    gap: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-xl);
    box-shadow: var(--shadow-card);
  }

  .tip-icon {
    font-size: 1.25rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .tip-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }

  .tip-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .tip-title code,
  .tip-text code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 1px 5px;
    border-radius: var(--radius-xs);
  }

  .tip-text {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .tables-section {
    display: flex;
    flex-direction: column;
  }

  .cards-section {
    margin-top: var(--space-section);
    padding-top: var(--space-xxl);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 116px;
  }

  .cards-header {
    margin-bottom: var(--space-xl);
  }

  .cards-heading {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs) 0;
  }

  .cards-subtext {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
