---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import ExampleCard from "../components/ExampleCard.astro";
import NavCard from "../components/NavCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  regexExamples,
  examplesCategories,
  examplesNavCards,
} from "../data/examplesRegex";
---

<Layout
  title="Real-World Regex Examples — Ready-to-Use Patterns & Code Snippets"
  description="A curated library of battle-tested regular expression examples for email, URLs, passwords, phone numbers, dates, UUIDs, and more — with multi-language code snippets for JavaScript, Python, and Java."
>
  <SiteNav />

  <Hero
    badge="Practical Patterns"
    title="Real-World Regex Examples"
    subtitle="Copy-paste ready regular expressions for common development tasks. Includes token breakdowns, matching test cases, and code snippets in JavaScript, Python, and Java."
  />

  <!-- Interactive Filter & Search Band -->
  <div class="filter-band">
    <div class="container-wide filter-inner">
      <!-- Search Input -->
      <div class="search-wrapper">
        <svg
          class="search-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="M21 21l-4.35-4.35"></path>
        </svg>
        <input
          type="search"
          id="example-search"
          class="search-input"
          placeholder="Filter examples (e.g. email, password, slug, date)..."
          aria-label="Filter regex examples"
        />
        <button
          type="button"
          id="clear-search"
          class="clear-btn"
          aria-label="Clear search"
          hidden
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Controls row: Category Pills & Global Language Switcher -->
      <div class="controls-row">
        <div
          class="category-pills"
          role="tablist"
          aria-label="Filter by category"
        >
          {
            examplesCategories.map((cat, idx) => (
              <button
                type="button"
                role="tab"
                class:list={["cat-pill", { active: idx === 0 }]}
                data-category={cat.id}
                aria-selected={idx === 0 ? "true" : "false"}
              >
                {cat.label}
              </button>
            ))
          }
        </div>

        <!-- Global Language Selector -->
        <div class="global-lang-control">
          <label for="global-lang-select" class="global-lang-label"
            >Language:</label
          >
          <select
            id="global-lang-select"
            class="global-lang-select"
            aria-label="Default code snippet language"
          >
            <option value="javascript">JavaScript</option>
            <option value="python">Python</option>
            <option value="java">Java</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <main id="main-content" class="container-wide main">
    <!-- Results Count Bar -->
    <div class="results-bar">
      <span id="results-count" class="results-text"
        >Showing all {regexExamples.length} examples</span
      >
    </div>

    <!-- Examples List -->
    <div class="examples-list" id="examples-container">
      {regexExamples.map((example) => <ExampleCard example={example} />)}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="empty-state" hidden>
      <div class="empty-icon" aria-hidden="true">🔍</div>
      <h3 class="empty-title">No matching examples found</h3>
      <p class="empty-desc">
        Try adjusting your search query or switching category filters.
      </p>
      <button type="button" id="reset-filters-btn" class="reset-btn"
        >Reset Filters</button
      >
    </div>

    <!-- Nav cards to other guides -->
    <section
      class="cards-section"
      id="explore-heading"
      aria-labelledby="explore-heading-title"
    >
      <div class="cards-header">
        <h2 class="cards-heading" id="explore-heading-title">
          Explore Reference Guides
        </h2>
        <p class="cards-subtext">
          Deep-dive into engine specific cheatsheets or test your patterns live.
        </p>
      </div>
      <div class="cards-grid">
        {examplesNavCards.map((card) => <NavCard card={card} />)}
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script>
  function setupExamplesPage() {
    const searchInput = document.getElementById(
      "example-search",
    ) as HTMLInputElement | null;
    const clearBtn = document.getElementById(
      "clear-search",
    ) as HTMLButtonElement | null;
    const catPills = document.querySelectorAll<HTMLButtonElement>(".cat-pill");
    const globalLangSelect = document.getElementById(
      "global-lang-select",
    ) as HTMLSelectElement | null;
    const container = document.getElementById("examples-container");
    const cards = document.querySelectorAll<HTMLElement>(".example-card");
    const emptyState = document.getElementById("empty-state");
    const resultsCount = document.getElementById("results-count");
    const resetBtn = document.getElementById("reset-filters-btn");

    if (!container || !cards.length) return;

    let currentCategory = "all";
    let currentSearch = "";

    // 1. Language Preference Management
    const savedLang =
      localStorage.getItem("preferred_regex_lang") || "javascript";
    if (globalLangSelect) {
      globalLangSelect.value = savedLang;
    }
    applyGlobalLanguage(savedLang);

    if (globalLangSelect) {
      globalLangSelect.addEventListener("change", (e) => {
        const lang = (e.target as HTMLSelectElement).value;
        localStorage.setItem("preferred_regex_lang", lang);
        applyGlobalLanguage(lang);
      });
    }

    function applyGlobalLanguage(lang: string) {
      cards.forEach((card) => {
        const tabs = card.querySelectorAll<HTMLButtonElement>(".lang-tab");
        const panels = card.querySelectorAll<HTMLElement>(".snippet-panel");

        tabs.forEach((tab) => {
          const isTarget = tab.dataset.lang === lang;
          tab.classList.toggle("active", isTarget);
          tab.setAttribute("aria-selected", isTarget ? "true" : "false");
        });

        panels.forEach((panel) => {
          const isTarget = panel.dataset.lang === lang;
          if (isTarget) {
            panel.removeAttribute("hidden");
          } else {
            panel.setAttribute("hidden", "true");
          }
        });
      });
    }

    // 2. Per-card Tab Switching
    document.addEventListener("click", (e) => {
      const tab = (e.target as HTMLElement)?.closest(
        ".lang-tab",
      ) as HTMLButtonElement | null;
      if (!tab) return;

      const cardSnippets = tab.closest(".code-snippets");
      if (!cardSnippets) return;

      const lang = tab.dataset.lang;
      if (!lang) return;

      const siblingTabs =
        cardSnippets.querySelectorAll<HTMLButtonElement>(".lang-tab");
      const siblingPanels =
        cardSnippets.querySelectorAll<HTMLElement>(".snippet-panel");

      siblingTabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle("active", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
      });

      siblingPanels.forEach((p) => {
        if (p.dataset.lang === lang) {
          p.removeAttribute("hidden");
        } else {
          p.setAttribute("hidden", "true");
        }
      });
    });

    // 3. Copy Code Buttons
    document.addEventListener("click", async (e) => {
      const copyBtn = (e.target as HTMLElement)?.closest(
        ".copy-code-btn",
      ) as HTMLButtonElement | null;
      if (!copyBtn) return;

      const cardSnippets = copyBtn.closest(".code-snippets");
      if (!cardSnippets) return;

      const activePanel = cardSnippets.querySelector<HTMLElement>(
        ".snippet-panel:not([hidden])",
      );
      const code = activePanel?.querySelector("code")?.textContent;
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code);
        const textSpan = copyBtn.querySelector(".copy-code-text");
        if (textSpan) {
          const orig = textSpan.textContent;
          textSpan.textContent = "Copied!";
          copyBtn.classList.add("copied");
          setTimeout(() => {
            textSpan.textContent = orig;
            copyBtn.classList.remove("copied");
          }, 1800);
        }
      } catch (err) {
        console.error("Failed to copy code snippet:", err);
      }
    });

    // 4. Copy Pattern Buttons
    document.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement)?.closest(
        ".copy-pattern-btn",
      ) as HTMLButtonElement | null;
      if (!btn) return;

      const pattern = btn.getAttribute("data-pattern");
      if (!pattern) return;

      try {
        await navigator.clipboard.writeText(pattern);
        const textSpan = btn.querySelector(".btn-text");
        if (textSpan) {
          const orig = textSpan.textContent;
          textSpan.textContent = "Copied!";
          btn.classList.add("copied");
          setTimeout(() => {
            textSpan.textContent = orig;
            btn.classList.remove("copied");
          }, 1800);
        }
      } catch (err) {
        console.error("Failed to copy pattern:", err);
      }
    });

    // 5. Search & Filter Logic
    function updateFilters() {
      const query = currentSearch.toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach((card) => {
        const category = card.getAttribute("data-category");
        const title =
          card.querySelector(".card-title")?.textContent?.toLowerCase() || "";
        const desc =
          card.querySelector(".card-desc")?.textContent?.toLowerCase() || "";
        const pattern =
          card.querySelector(".pattern-code")?.textContent?.toLowerCase() || "";

        const matchesCategory =
          currentCategory === "all" || category === currentCategory;
        const matchesQuery =
          !query ||
          title.includes(query) ||
          desc.includes(query) ||
          pattern.includes(query);

        if (matchesCategory && matchesQuery) {
          card.style.display = "";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      if (resultsCount) {
        if (query || currentCategory !== "all") {
          resultsCount.textContent = `Showing ${visibleCount} of ${cards.length} examples`;
        } else {
          resultsCount.textContent = `Showing all ${cards.length} examples`;
        }
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute("hidden");
        } else {
          emptyState.setAttribute("hidden", "true");
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener("input", () => {
        currentSearch = searchInput.value;
        if (clearBtn) {
          if (currentSearch) {
            clearBtn.removeAttribute("hidden");
          } else {
            clearBtn.setAttribute("hidden", "true");
          }
        }
        updateFilters();
      });
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener("click", () => {
        searchInput.value = "";
        currentSearch = "";
        clearBtn.setAttribute("hidden", "true");
        searchInput.focus();
        updateFilters();
      });
    }

    catPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        catPills.forEach((p) => {
          p.classList.remove("active");
          p.setAttribute("aria-selected", "false");
        });
        pill.classList.add("active");
        pill.setAttribute("aria-selected", "true");
        currentCategory = pill.getAttribute("data-category") || "all";
        updateFilters();
      });
    });

    if (resetBtn && searchInput) {
      resetBtn.addEventListener("click", () => {
        searchInput.value = "";
        currentSearch = "";
        if (clearBtn) clearBtn.setAttribute("hidden", "true");
        catPills.forEach((p, idx) => {
          const isFirst = idx === 0;
          p.classList.toggle("active", isFirst);
          p.setAttribute("aria-selected", isFirst ? "true" : "false");
        });
        currentCategory = "all";
        updateFilters();
      });
    }
  }

  setupExamplesPage();
  document.addEventListener("astro:page-load", setupExamplesPage);
</script>

<style>
  /* ── Filter Band ── */
  .filter-band {
    position: sticky;
    top: 56px;
    z-index: 90;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-md) 0;
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.03);
  }

  .filter-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    color: var(--color-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    height: 44px;
    padding: 0 40px 0 42px;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    outline: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .search-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgb(91 33 182 / 0.12);
  }

  .clear-btn {
    position: absolute;
    right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    border: none;
    background: var(--color-border);
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: background 0.12s ease;
  }

  .clear-btn:hover {
    background: var(--color-muted-soft);
    color: var(--color-surface);
  }

  .controls-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .category-pills {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px 0;
  }

  .category-pills::-webkit-scrollbar {
    display: none;
  }

  .cat-pill {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 5px 12px;
    border-radius: var(--radius-full);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.12s ease;
    flex-shrink: 0;
  }

  .cat-pill:hover {
    background: var(--color-hover);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cat-pill.active {
    background: var(--color-accent-subtle);
    border-color: var(--color-accent);
    color: var(--color-accent);
    font-weight: 600;
  }

  .global-lang-control {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .global-lang-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .global-lang-select {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 4px 8px;
    cursor: pointer;
    outline: none;
  }

  .global-lang-select:focus {
    border-color: var(--color-accent);
  }

  /* ── Main Layout ── */
  .main {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-xl);
  }

  .results-bar {
    margin-bottom: var(--space-md);
  }

  .results-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .examples-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* ── Empty State ── */
  .empty-state {
    text-align: center;
    padding: var(--space-xxl) var(--space-lg);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    margin-top: var(--space-md);
  }

  .empty-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-sm);
  }

  .empty-title {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs) 0;
  }

  .empty-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0 0 var(--space-md) 0;
  }

  .reset-btn {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border: none;
    padding: 8px 18px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: background 0.12s ease;
  }

  .reset-btn:hover {
    background: var(--color-accent-hover);
  }

  /* ── Cards Section ── */
  .cards-section {
    margin-top: var(--space-section);
    padding-top: var(--space-xxl);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 116px;
  }

  .cards-header {
    margin-bottom: var(--space-xl);
  }

  .cards-heading {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs) 0;
  }

  .cards-subtext {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
