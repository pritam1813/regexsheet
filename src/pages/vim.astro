---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import SectionNav from "../components/SectionNav.astro";
import RegexTable from "../components/RegexTable.astro";
import VimRecipes from "../components/VimRecipes.astro";
import NavCard from "../components/NavCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { vimRegexCategories, vimNavCards } from "../data/vimRegex";

const navItems = [
  { id: "search-substitute-cmds", label: "Search & Substitute" },
  { id: "magic-modes", label: "Magic Modes (\\v, \\m)" },
  { id: "character-classes", label: "Character Classes" },
  { id: "match-limits-lookarounds", label: "Boundaries & Lookarounds" },
  { id: "replace-expressions", label: "Replace Expressions" },
  { id: "recipes", label: "Code Recipes" },
  { id: "explore-heading", label: "Other Guides" },
];
---

<Layout
  title="Vim Regex Cheat Sheet — Search & Substitute Reference"
  description="A comprehensive, fast Vim regular expressions cheat sheet. Covers very magic mode (\\v), search & replace (:%s), global delete (:g and :v), match boundaries (\\zs, \\ze), expression register (\\=), character classes, and practical Vim recipes."
>
  <SiteNav />
  <Hero
    badge="Editor & Terminal Reference"
    title="Vim Regex Cheat Sheet"
    subtitle="Complete quick reference for pattern searching and substitution in Vim / Neovim — very magic mode (\v), :s command, :g/:v filters, \zs & \ze match bounds, expression evaluations (\=), and recipes."
  />
  <SectionNav items={navItems} />

  <main id="main-content" class="container-wide main">
    <!-- Vim Tip Callout -->
    <div class="tip-callout" role="note" aria-label="Vim Regex Pro Tip">
      <div class="tip-icon" aria-hidden="true">💡</div>
      <div class="tip-content">
        <span class="tip-title"
          >Pro Tip: Prefix with Very Magic <code>\v</code> &amp; Use <code>\zs</code> / <code>\ze</code> for Boundaries</span
        >
        <p class="tip-text">
          By default in Vim (magic mode <code>\m</code>), grouping parentheses and quantifiers require backslashes (e.g. <code>\(\d\+\)</code>). Prefixing patterns with <code>\v</code> enables <strong>very magic</strong> mode where <code>+</code>, <code>?</code>, <code>( )</code>, <code>{ }</code>, and <code>|</code> behave like modern PCRE regex without backslashes.
          Use <code>\zs</code> (start match) and <code>\ze</code> (end match) to change text inside quotes or tags without capturing groups.
          In replacement, remember that <code>\r</code> inserts a line break (using <code>\n</code> inserts a null byte <code>\x00</code>!).
        </p>
      </div>
    </div>

    <!-- Vim regex reference tables -->
    <section class="tables-section" aria-label="Vim regular expressions reference">
      {
        vimRegexCategories.map((category) => (
          <RegexTable category={category} />
        ))
      }
    </section>

    <!-- Vim Code Recipes -->
    <VimRecipes />

    <!-- Nav cards to other guides -->
    <section
      class="cards-section"
      id="explore-heading"
      aria-labelledby="explore-heading-title"
    >
      <div class="cards-header">
        <h2 class="cards-heading" id="explore-heading-title">
          Explore Other Guides
        </h2>
        <p class="cards-subtext">
          Switch to programming language guides, database queries, or test
          expressions interactively.
        </p>
      </div>
      <div class="cards-grid">
        {vimNavCards.map((card) => <NavCard card={card} />)}
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .main {
    padding-top: var(--space-section);
    padding-bottom: var(--space-xl);
  }

  .tip-callout {
    display: flex;
    gap: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-xl);
    box-shadow: var(--shadow-card);
  }

  .tip-icon {
    font-size: 1.25rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .tip-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }

  .tip-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .tip-title code,
  .tip-text code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 1px 5px;
    border-radius: var(--radius-xs);
  }

  .tip-text {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .tables-section {
    display: flex;
    flex-direction: column;
  }

  .cards-section {
    margin-top: var(--space-section);
    padding-top: var(--space-xxl);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 116px;
  }

  .cards-header {
    margin-bottom: var(--space-xl);
  }

  .cards-heading {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs) 0;
  }

  .cards-subtext {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
