---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const popularLinks = [
  {
    href: "/",
    title: "Cheat Sheet Home",
    desc: "Universal regex syntax tables & reference",
    icon: "📖",
  },
  {
    href: "/tester",
    title: "Live Regex Tester",
    desc: "Test patterns & strings with instant highlights",
    icon: "⚡",
  },
  {
    href: "/examples",
    title: "Regex Examples",
    desc: "Real-world recipes for email, IP, dates, URLs",
    icon: "💡",
  },
  {
    href: "/pdf",
    title: "Download PDF",
    desc: "Printable cheat sheets for offline reference",
    icon: "📄",
  },
];

const languagePills = [
  { name: "JavaScript", href: "/javascript" },
  { name: "Python", href: "/python" },
  { name: "C#", href: "/csharp" },
  { name: "Java", href: "/java" },
  { name: "R", href: "/r" },
  { name: "SQL", href: "/sql" },
  { name: "Perl", href: "/perl" },
  { name: "Notepad++", href: "/notepad-plus-plus" },
  { name: "Vim", href: "/vim" },
  { name: "Grep", href: "/grep" },
];
---

<Layout
  title="404 — Pattern Not Found | regexsheet"
  description="Error 404: The requested URL did not match any regex route. Test a regex, resolve a valid route, or return to the cheat sheet."
>
  <SiteNav activePath="/404" />

  <header class="error-hero">
    <div class="container-wide hero-inner">
      <!-- Error Status Badge -->
      <div class="badge-wrapper">
        <span class="error-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <code>/(?&lt;error&gt;404)/i</code> &bull; 0 matches returned
        </span>
      </div>

      <!-- Regex Big 404 Display -->
      <div class="regex-display" aria-label="Error 404: Pattern not found">
        <span class="regex-slash" aria-hidden="true">/</span>
        <span class="regex-num">404</span>
        <span class="regex-slash" aria-hidden="true">/</span>
        <span class="regex-flags">
          <span class="flag-chip">g</span>
          <span class="flag-chip">i</span>
        </span>
      </div>

      <h1 class="hero-title">Pattern Not Found</h1>
      <p class="hero-subtitle">
        Lookahead assertion failed. The route you requested resulted in <code class="inline-code">null</code> and matched 0 capturing groups.
      </p>

      <!-- Client-side Path Inspector -->
      <div id="path-inspector" class="path-inspector" hidden>
        <span class="path-label">Attempted path:</span>
        <code id="lost-path" class="path-val"></code>
        <span class="path-result">&rarr; <strong class="text-error">No match</strong></span>
      </div>

      <!-- Primary Action Buttons -->
      <div class="hero-actions">
        <a href="/" class="btn btn-primary" id="btn-home">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          Back to Home
        </a>
        <a href="/tester" class="btn btn-secondary" id="btn-tester">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          Open Live Tester
        </a>
      </div>
    </div>
  </header>

  <main class="container-wide main-section" id="main-content">
    <!-- Interactive Fun Regex Route Resolver -->
    <section class="interactive-section" aria-labelledby="interactive-heading">
      <div class="interactive-card">
        <div class="card-top-bar">
          <div class="card-header-info">
            <div class="terminal-dots" aria-hidden="true">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <h2 class="card-title" id="interactive-heading">Interactive Route Resolver</h2>
          </div>
          <span class="card-tag">Fun Tool</span>
        </div>

        <div class="card-body">
          <p class="resolver-desc">
            Type a regular expression below to search and match valid site routes in real-time:
          </p>

          <!-- Input bar -->
          <div class="resolver-input-wrap">
            <span class="input-delim" aria-hidden="true">/</span>
            <input
              id="route-regex-input"
              type="text"
              class="route-input"
              placeholder="e.g. py|js|test.*|^/e"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              aria-label="Filter routes with regex"
            />
            <span class="input-delim" aria-hidden="true">/i</span>
            <button id="clear-regex-btn" class="clear-btn" type="button" aria-label="Clear pattern" title="Clear">
              &times;
            </button>
          </div>

          <!-- Quick pattern preset chips -->
          <div class="preset-row">
            <span class="preset-label">Try shortcuts:</span>
            <button type="button" class="preset-chip" data-pattern="^(javascript|python)$"><code>^(javascript|python)$</code></button>
            <button type="button" class="preset-chip" data-pattern="tester|pdf|examples"><code>tester|pdf|examples</code></button>
            <button type="button" class="preset-chip" data-pattern="^[a-z]{3,4}$"><code>^[a-z]&#123;3,4&#125;$</code></button>
            <button type="button" class="preset-chip" data-pattern=".*"><code>.* (All)</code></button>
            <button type="button" class="preset-chip" data-pattern="^404$"><code>^404$</code></button>
          </div>

          <!-- Match results area -->
          <div class="match-results-wrap">
            <div class="match-header">
              <span id="match-count-text" class="match-count">Showing all available routes (14 matches)</span>
              <span id="easter-egg-msg" class="easter-egg" hidden></span>
            </div>
            <div id="route-pills-container" class="route-pills-grid">
              <!-- Dynamically populated / client rendered -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Regex Anatomy of a 404 -->
    <section class="anatomy-section" aria-labelledby="anatomy-heading">
      <h2 class="section-title" id="anatomy-heading">Anatomy of our 404 Pattern</h2>
      <div class="anatomy-grid">
        <div class="anatomy-card">
          <code class="anatomy-token">^</code>
          <div class="anatomy-info">
            <span class="anatomy-name">Start of Line</span>
            <p class="anatomy-text">Asserts the starting position of your lost journey.</p>
          </div>
        </div>
        <div class="anatomy-card">
          <code class="anatomy-token">404</code>
          <div class="anatomy-info">
            <span class="anatomy-name">Literal Match</span>
            <p class="anatomy-text">Matches the exact HTTP status code: Not Found.</p>
          </div>
        </div>
        <div class="anatomy-card">
          <code class="anatomy-token">(\.html)?</code>
          <div class="anatomy-info">
            <span class="anatomy-name">Optional Group</span>
            <p class="anatomy-text">Extension quantifier (0 or 1 time). Still missing either way.</p>
          </div>
        </div>
        <div class="anatomy-card">
          <code class="anatomy-token">$</code>
          <div class="anatomy-info">
            <span class="anatomy-name">End of Line</span>
            <p class="anatomy-text">Dead end reached. Catastrophic backtracking averted.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Popular Destinations Grid -->
    <section class="popular-section" aria-labelledby="popular-heading">
      <h2 class="section-title" id="popular-heading">Popular Destinations</h2>
      <div class="cards-grid">
        {popularLinks.map((item) => (
          <a href={item.href} class="nav-card">
            <span class="nav-card-icon" aria-hidden="true">{item.icon}</span>
            <div class="nav-card-body">
              <span class="nav-card-title">{item.title}</span>
              <p class="nav-card-desc">{item.desc}</p>
            </div>
            <svg class="nav-card-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Language Quick Reference Pills -->
    <section class="languages-section" aria-labelledby="languages-heading">
      <h2 class="section-title" id="languages-heading">Language & Tool Guides</h2>
      <div class="lang-pills-wrap">
        {languagePills.map((lang) => (
          <a href={lang.href} class="lang-pill">
            {lang.name}
          </a>
        ))}
      </div>
    </section>

    <!-- Geeky Regex Joke Generator -->
    <section class="joke-section" aria-labelledby="joke-heading">
      <div class="joke-card">
        <div class="joke-header">
          <span class="joke-icon" aria-hidden="true">💬</span>
          <div>
            <h3 class="joke-title" id="joke-heading">Regex Humor Generator</h3>
            <p class="joke-sub">While you're here, have a chuckle:</p>
          </div>
        </div>
        <blockquote class="joke-quote" id="joke-display">
          "Some people, when confronted with a problem, think 'I know, I'll use regular expressions.' Now they have two problems."
        </blockquote>
        <div class="joke-author" id="joke-author">&mdash; Jamie Zawinski</div>
        <button type="button" class="btn btn-secondary joke-btn" id="next-joke-btn">
          <span>🎲 Roll Another Joke</span>
        </button>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script is:inline>
  // List of all valid site routes for interactive matching
  const ALL_ROUTES = [
    { path: "/", title: "Home (Universal Cheat Sheet)", category: "Reference" },
    { path: "/javascript", title: "JavaScript Regex", category: "Language" },
    { path: "/python", title: "Python Regex (re)", category: "Language" },
    { path: "/csharp", title: "C# (.NET Regex)", category: "Language" },
    { path: "/java", title: "Java Regex (Pattern)", category: "Language" },
    { path: "/r", title: "R Regex (stringr & base)", category: "Language" },
    { path: "/sql", title: "SQL Regex (POSIX & LIKE)", category: "Language" },
    { path: "/perl", title: "Perl Regex", category: "Language" },
    { path: "/notepad-plus-plus", title: "Notepad++ Search", category: "Tool" },
    { path: "/vim", title: "Vim & Neovim Patterns", category: "Tool" },
    { path: "/grep", title: "Grep / Ripgrep Cheatsheet", category: "Tool" },
    { path: "/examples", title: "Practical Examples", category: "Recipes" },
    { path: "/tester", title: "Live Regex Tester", category: "Tool" },
    { path: "/pdf", title: "Download PDF Cards", category: "Download" },
  ];

  // Regex Jokes Collection
  const REGEX_JOKES = [
    {
      quote: "Some people, when confronted with a problem, think 'I know, I'll use regular expressions.' Now they have two problems.",
      author: "Jamie Zawinski",
    },
    {
      quote: "There is no place like ^~/$",
      author: "Unix Proverb",
    },
    {
      quote: "A regular expression walks into a bar. The bartender says, 'What can I get you?' The regex replies: '.*'",
      author: "Anonymous Sysadmin",
    },
    {
      quote: "Why did the developer break up with Regex? Because there were too many unclosed capturing groups and non-stop backtracking.",
      author: "Dev Humor",
    },
    {
      quote: "Lookahead: because sometimes in life, you just want to judge what is coming next without committing to it.",
      author: "Regex Philosophy",
    },
    {
      quote: "Regex quantifier: '?' means optional, '*' means zero or more, and '+' means one or more sleepless nights.",
      author: "StackOverflow Lore",
    },
    {
      quote: "If at first you don't succeed, try adding the /g flag.",
      author: "JavaScript Wisdom",
    },
  ];

  document.addEventListener("DOMContentLoaded", () => {
    // 1. Show current attempted path
    const inspectorEl = document.getElementById("path-inspector");
    const lostPathEl = document.getElementById("lost-path");
    if (inspectorEl && lostPathEl && typeof window !== "undefined") {
      const currentPath = window.location.pathname;
      if (currentPath && currentPath !== "/404" && currentPath !== "/404.html") {
        lostPathEl.textContent = currentPath;
        inspectorEl.removeAttribute("hidden");
      }
    }

    // 2. Interactive Route Resolver
    const inputEl = document.getElementById("route-regex-input");
    const clearBtn = document.getElementById("clear-regex-btn");
    const container = document.getElementById("route-pills-container");
    const countText = document.getElementById("match-count-text");
    const easterEggEl = document.getElementById("easter-egg-msg");
    const presetButtons = document.querySelectorAll(".preset-chip");

    function renderRoutes(patternStr = "") {
      if (!container) return;
      container.innerHTML = "";
      if (easterEggEl) easterEggEl.hidden = true;

      let reg = null;
      let isRegexValid = true;
      let errorMsg = "";

      const trimmed = patternStr.trim();

      // Easter egg checks
      if (easterEggEl && (trimmed === "^404$" || trimmed === "404")) {
        easterEggEl.textContent = "🎉 Match Found! You discovered the 404 error!";
        easterEggEl.hidden = false;
      }

      if (trimmed.length > 0) {
        try {
          reg = new RegExp(trimmed, "i");
        } catch (e) {
          isRegexValid = false;
          errorMsg = e instanceof Error ? e.message : "Invalid regex";
        }
      }

      if (!isRegexValid) {
        if (countText) {
          countText.innerHTML = `<span class="text-error">⚠️ Regex Syntax Error: ${errorMsg}</span>`;
        }
        return;
      }

      const matches = ALL_ROUTES.filter((r) => {
        if (!reg) return true;
        return reg.test(r.path) || reg.test(r.title) || reg.test(r.category);
      });

      if (countText) {
        countText.textContent = trimmed
          ? `Found ${matches.length} matching route${matches.length === 1 ? "" : "s"} for /${trimmed}/i`
          : `Showing all available routes (${matches.length} matches)`;
      }

      if (matches.length === 0) {
        const noMatch = document.createElement("div");
        noMatch.className = "no-route-msg";
        noMatch.innerHTML = `No routes match <code>/${trimmed}/i</code>. Try <button type="button" class="inline-reset-btn" id="inline-reset">resetting</button> or explore our cheatsheets below.`;
        container.appendChild(noMatch);
        const resetBtn = document.getElementById("inline-reset");
        if (resetBtn) {
          resetBtn.addEventListener("click", () => {
            if (inputEl) {
              inputEl.value = "";
              renderRoutes("");
            }
          });
        }
        return;
      }

      matches.forEach((r) => {
        const pill = document.createElement("a");
        pill.href = r.path;
        pill.className = "route-pill";

        let displayPath = r.path;
        if (reg && trimmed) {
          try {
            displayPath = r.path.replace(reg, (m) => `<mark class="regex-highlight">${m}</mark>`);
          } catch (_) {
            displayPath = r.path;
          }
        }

        pill.innerHTML = `
          <div class="route-pill-head">
            <span class="route-pill-tag">${r.category}</span>
            <span class="route-pill-arrow">&rarr;</span>
          </div>
          <span class="route-pill-path"><code>${displayPath}</code></span>
          <span class="route-pill-name">${r.title}</span>
        `;
        container.appendChild(pill);
      });
    }

    // Initial render
    renderRoutes("");

    if (inputEl) {
      inputEl.addEventListener("input", (e) => {
        renderRoutes(e.target.value);
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        if (inputEl) {
          inputEl.value = "";
          inputEl.focus();
          renderRoutes("");
        }
      });
    }

    presetButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const pat = btn.getAttribute("data-pattern") || "";
        if (inputEl) {
          inputEl.value = pat;
          renderRoutes(pat);
          inputEl.focus();
        }
      });
    });

    // 3. Joke Generator
    const jokeDisplay = document.getElementById("joke-display");
    const jokeAuthor = document.getElementById("joke-author");
    const jokeBtn = document.getElementById("next-joke-btn");
    let currentJokeIdx = 0;

    if (jokeBtn && jokeDisplay && jokeAuthor) {
      jokeBtn.addEventListener("click", () => {
        let newIdx;
        do {
          newIdx = Math.floor(Math.random() * REGEX_JOKES.length);
        } while (newIdx === currentJokeIdx && REGEX_JOKES.length > 1);

        currentJokeIdx = newIdx;
        const joke = REGEX_JOKES[currentJokeIdx];
        jokeDisplay.textContent = `"${joke.quote}"`;
        jokeAuthor.innerHTML = `&mdash; ${joke.author}`;
      });
    }
  });
</script>

<style>
  /* ── Hero Section ────────────────────────────────────────── */
  .error-hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-xxl);
    padding-bottom: var(--space-xxl);
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .error-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 6%, transparent) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .badge-wrapper {
    display: flex;
    justify-content: center;
  }

  .error-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-error-text);
    background: var(--color-error-bg);
    border: 1px solid var(--color-error-border);
    border-radius: var(--radius-full);
    padding: 4px 14px;
  }

  .error-badge code {
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-error);
    display: inline-block;
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* ── Big 404 Regex Display ──────────────────────────────── */
  .regex-display {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-family: var(--font-mono);
    margin-top: var(--space-xs);
    user-select: none;
  }

  .regex-slash {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 300;
    color: var(--color-muted-soft);
    line-height: 1;
  }

  .regex-num {
    font-size: clamp(3.5rem, 10vw, 6.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-ink);
    line-height: 1;
    text-shadow: 0 4px 12px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .regex-flags {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-left: 4px;
  }

  .flag-chip {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    border-radius: var(--radius-xs);
    padding: 1px 6px;
    line-height: 1.2;
  }

  .hero-title {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0;
  }

  .hero-subtitle {
    font-size: 1rem;
    color: var(--color-muted);
    max-width: 560px;
    margin: 0;
    line-height: 1.6;
  }

  .inline-code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
  }

  /* Path Inspector */
  .path-inspector {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 6px 14px;
    font-size: 0.875rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .path-label {
    color: var(--color-muted);
    font-size: 0.8125rem;
  }

  .path-val {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-ink);
    word-break: break-all;
  }

  .path-result {
    font-size: 0.8125rem;
  }

  .text-error {
    color: var(--color-error-text);
  }

  /* Hero action buttons */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
    margin-top: var(--space-sm);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border: 1px solid var(--color-accent);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .btn-secondary {
    background: var(--color-surface);
    color: var(--color-ink);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  /* ── Main Sections ───────────────────────────────────────── */
  .main-section {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-section);
    display: flex;
    flex-direction: column;
    gap: var(--space-xxl);
  }

  .section-title {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0 0 var(--space-md) 0;
  }

  /* ── Interactive Route Resolver ─────────────────────────── */
  .interactive-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .card-top-bar {
    background: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-sm) var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-header-info {
    display: flex;
