---
import Layout from "../../layouts/Layout.astro";
import { pdfCheatSheets, type PdfCheatSheet } from "../../data/pdfs";
import { universalRegex } from "../../data/regex";
import { javascriptRegexCategories } from "../../data/javascriptRegex";
import { pythonRegexCategories } from "../../data/pythonRegex";
import { javaRegexCategories } from "../../data/javaRegex";
import { rRegexCategories } from "../../data/rRegex";
import { csharpRegexCategories } from "../../data/csharpRegex";
import { sqlRegexCategories } from "../../data/sqlRegex";
import { perlRegexCategories } from "../../data/perlRegex";
import { notepadppRegexCategories } from "../../data/notepadppRegex";
import { vimRegexCategories } from "../../data/vimRegex";
import { grepRegexCategories } from "../../data/grepRegex";
import type { RegexCategory } from "../../data/regex";

export function getStaticPaths() {
  const dataMap: Record<string, RegexCategory[]> = {
    universal: universalRegex,
    javascript: javascriptRegexCategories,
    python: pythonRegexCategories,
    java: javaRegexCategories,
    r: rRegexCategories,
    csharp: csharpRegexCategories,
    sql: sqlRegexCategories,
    perl: perlRegexCategories,
    "notepad-plus-plus": notepadppRegexCategories,
    vim: vimRegexCategories,
    grep: grepRegexCategories,
  };

  return pdfCheatSheets.map((sheet) => ({
    params: { slug: sheet.slug },
    props: {
      sheet,
      categories: dataMap[sheet.slug] || [],
    },
  }));
}

interface Props {
  sheet: PdfCheatSheet;
  categories: RegexCategory[];
}

const { sheet, categories } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{sheet.title} — Printable Cheat Sheet</title>
    <meta name="description" content={`Printable single-page PDF cheat sheet for ${sheet.title}.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="print-body">
    <!-- Non-printing toolbar -->
    <header class="no-print print-toolbar">
      <div class="toolbar-inner">
        <div class="toolbar-left">
          <a href="/pdf" class="toolbar-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>Back to PDFs</span>
          </a>
          <span class="toolbar-divider"></span>
          <span class="toolbar-title">{sheet.title}</span>
          <span class="toolbar-badge">{sheet.badge}</span>
        </div>

        <div class="toolbar-actions">
          <button type="button" class="btn-print" onclick="window.print()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            <span>Print / Save as PDF</span>
          </button>
        </div>
      </div>

      <!-- Quick instructions bar -->
      <div class="toolbar-tips">
        <span>💡 <strong>Tip for best PDF output:</strong> In Chrome/Edge Print Dialog, choose Destination: <em>Save as PDF</em>, Margins: <em>None / Minimum</em>, and ensure <em>Background graphics</em> is checked.</span>
      </div>
    </header>

    <!-- Printable Sheet Document -->
    <div class="print-document">
      <!-- Sheet Header -->
      <div class="sheet-header">
        <div class="brand-row">
          <div class="brand-logo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="24" height="24" rx="6" fill="#5b21b6"/>
              <text x="4" y="17" font-family="monospace" font-weight="bold" font-size="14" fill="#ffffff">.*</text>
            </svg>
            <span class="brand-name">regexsheet<strong>.com</strong></span>
          </div>
          <div class="sheet-meta-pill">
            <span>{sheet.badge}</span>
            <span class="dot">•</span>
            <span>Quick Reference</span>
          </div>
        </div>

        <div class="title-row">
          <h1 class="sheet-title">{sheet.title}</h1>
          <p class="sheet-desc">{sheet.description}</p>
        </div>
      </div>

      <!-- Categories Columns Layout -->
      <div class="sheet-grid">
        {
          categories.map((category) => (
            <section class="category-block">
              <div class="category-header">
                <h2 class="category-title">{category.title}</h2>
              </div>
              <table class="category-table">
                <tbody>
                  {category.entries.map((entry) => (
                    <tr class="entry-row">
                      <td class="syntax-cell">
                        <code>{entry.syntax}</code>
                      </td>
                      <td class="desc-cell">
                        <span class="entry-desc">{entry.description}</span>
                        {entry.example && (
                          <span class="entry-example">
                            <code>{entry.example}</code>
                          </span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          ))
        }
      </div>

      <!-- Sheet Footer -->
      <footer class="sheet-footer">
        <div class="footer-left">
          <span>Free printable cheat sheet from <strong>regexsheet.com</strong></span>
        </div>
        <div class="footer-right">
          <span>Online interactive guide: <strong>https://regexsheet.com{sheet.targetPage}</strong></span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  /* ==========================================================
     Print Layout & Reset Styles
     ========================================================== */
  :root {
    --color-primary: #5b21b6;
    --color-primary-subtle: #f5f3ff;
    --color-primary-border: #ddd6fe;
    --color-ink: #1a1a2e;
    --color-ink-muted: #52525b;
    --color-code: #4c1d95;
    --color-border: #e4e4e7;
    --color-row-alt: #fafafa;
    --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: "JetBrains Mono", "Fira Code", monospace;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    font-family: var(--font-sans);
    color: var(--color-ink);
    background-color: #e5e7eb;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  /* Screen toolbar */
  .print-toolbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #ffffff;
    border-bottom: 1px solid #d1d5db;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .toolbar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .toolbar-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #4b5563;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 6px;
    background: #f3f4f6;
    transition: background 0.15s, color 0.15s;
  }

  .toolbar-back:hover {
    background: #e5e7eb;
    color: #111827;
  }

  .toolbar-divider {
    width: 1px;
    height: 20px;
    background: #e5e7eb;
  }

  .toolbar-title {
    font-size: 1rem;
    font-weight: 700;
    color: #111827;
  }

  .toolbar-badge {
    font-size: 0.75rem;
    font-weight: 600;
    background: #ede9fe;
    color: #5b21b6;
    padding: 2px 8px;
    border-radius: 9999px;
  }

  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-print {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #5b21b6;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 8px 20px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    box-shadow: 0 1px 3px rgba(91, 33, 182, 0.3);
    transition: background 0.15s, transform 0.1s;
  }

  .btn-print:hover {
    background: #4c1d95;
    transform: translateY(-1px);
  }

  .toolbar-tips {
    background: #faf5ff;
    border-top: 1px solid #ede9fe;
    padding: 8px 24px;
    font-size: 0.8125rem;
    color: #6b21a8;
    text-align: center;
  }

  /* Document Container (Rendered on Screen as a Sheet) */
  .print-document {
    width: 100%;
    max-width: 210mm; /* A4 width */
    min-height: 297mm; /* A4 height */
    margin: 24px auto;
    padding: 10mm 12mm 8mm 12mm;
    background: #ffffff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Sheet Header */
  .sheet-header {
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 8px;
    margin-bottom: 10px;
  }

  .brand-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .brand-name {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: #111827;
    letter-spacing: -0.02em;
  }

  .brand-name strong {
    color: #5b21b6;
  }

  .sheet-meta-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: #5b21b6;
    background: #ede9fe;
    padding: 2px 8px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .sheet-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #111827;
  }

  .sheet-desc {
    font-size: 0.75rem;
    color: #4b5563;
    max-width: 60%;
    text-align: right;
    line-height: 1.3;
  }

  /* Categories multi-column masonry */
  .sheet-grid {
    column-count: 2;
    column-gap: 10px;
    flex: 1 0 auto;
  }

  .category-block {
    break-inside: avoid;
    page-break-inside: avoid;
    margin-bottom: 10px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    background: #ffffff;
  }

  .category-header {
    background: var(--color-primary-subtle);
    border-bottom: 1px solid var(--color-primary-border);
    padding: 3px 8px;
  }

  .category-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary);
  }

  .category-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.71875rem; /* ~11.5px */
    line-height: 1.3;
  }

  .entry-row:nth-child(even) {
    background: var(--color-row-alt);
  }

  .entry-row:not(:last-child) {
    border-bottom: 1px solid #f4f4f5;
  }

  .syntax-cell {
    padding: 3px 6px;
    vertical-align: top;
    white-space: nowrap;
    width: 32%;
    border-right: 1px solid #f4f4f5;
  }

  .syntax-cell code {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.71875rem;
    color: var(--color-code);
    background: #f3f0ff;
    padding: 1px 4px;
    border-radius: 3px;
    display: inline-block;
  }

  .desc-cell {
    padding: 3px 6px;
    vertical-align: top;
    color: var(--color-ink);
  }

  .entry-desc {
    display: block;
    font-weight: 500;
    color: #27272a;
  }

  .entry-example {
    display: block;
    margin-top: 1px;
  }

  .entry-example code {
    font-family: var(--font-mono);
    font-size: 0.65625rem; /* ~10.5px */
    color: #059669;
    background: #ecfdf5;
    padding: 0 3px;
    border-radius: 2px;
  }

  /* Sheet Footer */
  .sheet-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 6px;
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: #71717a;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .sheet-footer strong {
    color: #5b21b6;
  }

  /* ==========================================================
     PRINT MEDIA RULES
     ========================================================== */
  @media print {
    @page {
      size: A4 portrait;
      margin: 8mm;
    }

    html, body {
      height: 100%;
      min-height: 100%;
      background: #ffffff !important;
      color: #000000 !important;
    }

    .no-print {
      display: none !important;
    }

    .print-document {
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
      width: 100% !important;
      max-width: none !important;
      min-height: calc(297mm - 16mm) !important;
      margin: 0 !important;
      padding: 0 !important;
      box-shadow: none !important;
      border-radius: 0 !important;
    }

    .sheet-grid {
      column-count: 2 !important;
      column-gap: 8mm !important;
      flex: 1 0 auto !important;
    }

    .category-block {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
      border: 1px solid #d4d4d8 !important;
    }

    .category-header {
      background: #f5f3ff !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .syntax-cell code {
      background: #f3f0ff !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .entry-example code {
      background: #ecfdf5 !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .sheet-footer {
      margin-top: auto !important;
      border-top: 1px solid #d4d4d8 !important;
      padding-top: 4px !important;
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }
  }
</style>
