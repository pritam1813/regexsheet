---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import SectionNav from "../components/SectionNav.astro";
import RegexTable from "../components/RegexTable.astro";
import PythonRecipes from "../components/PythonRecipes.astro";
import NavCard from "../components/NavCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { pythonRegexCategories, pythonNavCards } from "../data/pythonRegex";

const navItems = [
  { id: "re-functions", label: "re Functions" },
  { id: "match-object", label: "Match Object" },
  { id: "flags", label: "Flags" },
  { id: "python-syntax", label: "Syntax & Groups" },
  { id: "recipes", label: "Code Recipes" },
  { id: "explore-heading", label: "Other Guides" },
];
---

<Layout
  title="Python Regex Cheat Sheet — re Module & Syntax Reference"
  description="A complete, fast Python regex cheat sheet. Covers Python's re module functions, Match objects, flags, and code recipes. Includes a free downloadable PDF."
>
  <SiteNav />
  <Hero
    badge="Python 3 Reference"
    title="Python Regex Cheat Sheet"
    subtitle="Complete quick reference for Python's standard re module — functions, match objects, flags, named groups, and practical code snippets."
  />
  <SectionNav items={navItems} />

  <main id="main-content" class="container-wide main">
    <!-- Python Tip Callout -->
    <div class="tip-callout" role="note" aria-label="Python Regex Pro Tip">
      <div class="tip-icon" aria-hidden="true">💡</div>
      <div class="tip-content">
        <span class="tip-title"
          >Pro Tip: Always use raw string notation <code>r"..."</code></span
        >
        <p class="tip-text">
          In Python, prefix all regex patterns with <code>r</code> (e.g. <code
            >r"\bword\b"</code
          >). Without the <code>r</code> prefix, Python processes backslashes as standard
          string escape sequences — turning <code>"\b"</code> into an ASCII backspace
          (<code>\x08</code>) instead of a regex word boundary.
        </p>
      </div>
    </div>

    <!-- Python regex reference tables -->
    <section class="tables-section" aria-label="Python re module reference">
      {
        pythonRegexCategories.map((category) => (
          <RegexTable category={category} />
        ))
      }
    </section>

    <!-- Python Code Recipes -->
    <PythonRecipes />

    <!-- Nav cards to other guides -->
    <section
      class="cards-section"
      id="explore-heading"
      aria-labelledby="explore-heading-title"
    >
      <div class="cards-header">
        <h2 class="cards-heading" id="explore-heading-title">
          Explore Other Guides
        </h2>
        <p class="cards-subtext">
          Switch to universal patterns, other programming languages, or download
          offline cheatsheets.
        </p>
      </div>
      <div class="cards-grid">
        {pythonNavCards.map((card) => <NavCard card={card} />)}
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .main {
    padding-top: var(--space-section);
    padding-bottom: var(--space-xl);
  }

  .tip-callout {
    display: flex;
    gap: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-xl);
    box-shadow: var(--shadow-card);
  }

  .tip-icon {
    font-size: 1.25rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .tip-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }

  .tip-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .tip-title code,
  .tip-text code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 1px 5px;
    border-radius: var(--radius-xs);
  }

  .tip-text {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .tables-section {
    display: flex;
    flex-direction: column;
  }

  .cards-section {
    margin-top: var(--space-section);
    padding-top: var(--space-xxl);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 116px;
  }

  .cards-header {
    margin-bottom: var(--space-xl);
  }

  .cards-heading {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs) 0;
  }

  .cards-subtext {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
