---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout
  title="Contact | Regex Cheat Sheet"
  description="Get in touch with the maintainer of regexsheet for feedback, bug reports, or sponsorship inquiries."
>
  <SiteNav />

  <main id="main-content" class="container-wide main-prose">
    <div class="prose-wrapper">
      <h1 class="page-title">Contact</h1>
      <p class="subtitle">Have a question, suggestion, or just want to say hi?</p>

      <div class="content-block">
        <h2>General Inquiries & Sponsorship</h2>
        <p>
          For general questions, business inquiries, or sponsorship opportunities, the best way to reach out is via email. 
        </p>
        <div class="action-card">
          <a href="mailto:pritam1813@gmail.com" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            pritam1813@gmail.com
          </a>
        </div>

        <h2>Bug Reports & Feature Requests</h2>
        <p>
          Because regexsheet is an open-source project, we prefer to track bugs, errors in the cheat sheet, and new feature requests publicly on GitHub. This helps other contributors see what's being worked on.
        </p>
        <div class="action-card github-card">
          <a href="https://github.com/pritam1813/regexsheet/issues" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            Open an Issue on GitHub
          </a>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  .main-prose {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xxl);
  }

  .prose-wrapper {
    max-width: 800px;
    margin: 0 auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-xl);
  }

  .page-title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs) 0;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-muted);
    margin: 0 0 var(--space-xl) 0;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .content-block {
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .content-block h2 {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: var(--space-xl) 0 var(--space-md) 0;
    letter-spacing: -0.01em;
  }
  
  .content-block h2:first-child {
    margin-top: 0;
  }

  .content-block p {
    margin: 0 0 var(--space-md) 0;
  }

  .action-card {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    margin: var(--space-lg) 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  
  .github-card {
    background: transparent;
    border: 1px dashed var(--color-border-hover);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-ink);
    color: var(--color-surface);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: transform 0.1s ease, opacity 0.15s ease;
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 10px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-secondary:hover {
    background: var(--color-hover);
    border-color: var(--color-border-hover);
  }

  @media (max-width: 640px) {
    .prose-wrapper {
      padding: var(--space-md);
      border-radius: var(--radius-md);
    }
    
    .action-card {
      align-items: stretch;
      text-align: center;
    }
    
    .btn-primary, .btn-secondary {
      justify-content: center;
    }
  }
</style>
